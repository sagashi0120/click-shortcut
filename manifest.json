{
  "manifest_version": 3,
  "name": "Click Shortcut",
  "version": "1.0.0",
  "description": "サイトごとにショートカットキーで指定した要素を自動クリックします",
  "permissions": ["storage"],
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
